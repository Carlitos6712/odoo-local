# =============================================================================
# .env.example - Plantilla de variables de entorno
# Autor: @Carlitos6712 (https://github.com/Carlitos6712)
#
# "./odoo.sh setup" copia este archivo a .env.
# Edita .env, nunca este archivo. .env no se sube a Git.
# =============================================================================

# Versión de Odoo (etiqueta de la imagen oficial "odoo"). Ejemplos: 17, 18.
# Ojo: una base de datos creada con una versión no abre con otra distinta.
ODOO_VERSION=18

# Versión de PostgreSQL. Odoo 18 necesita PostgreSQL 12 o superior.
POSTGRES_VERSION=16

# Puerto de tu ordenador donde se abrirá Odoo: http://localhost:8079
# No usamos el 8069 (el habitual de Odoo) para no quitárselo a otro Odoo
# que tengas instalado, aunque esté apagado al instalar este.
# Si el 8079 ya está ocupado, "setup" y "start" eligen el siguiente libre
# y lo guardan en .env automáticamente.
ODOO_PORT=8079

# Usuario y contraseña de PostgreSQL. Solo se usan dentro de Docker:
# esta base de datos no se publica en tu ordenador ni choca con otro PostgreSQL.
# Cámbialos antes del primer "start"; después, cambiarlos rompe la conexión
# (tendrías que hacer "reset" y empezar de cero).
DB_USER=odoo
DB_PASSWORD=cambia_esta_clave
